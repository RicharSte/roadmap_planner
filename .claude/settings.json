{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm format *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo test)",
      "Bash(cargo check)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(plannotator *)",
      "Bash(nohup plannotator *)",
      "Bash(mkdir -p .reviews*)",
      "Bash(git add -N .)",
      "Bash(rm -f .reviews/*)",
      "Bash(rtk pnpm *)",
      "Bash(rtk cargo *)",
      "Bash(rtk vitest *)",
      "Bash(rtk tsc *)",
      "Bash(rtk lint *)",
      "Bash(rtk prettier *)",
      "Bash(rtk git status*)",
      "Bash(rtk git diff*)",
      "Bash(rtk git log*)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(cargo add *)",
      "Bash(git commit *)",
      "Edit(/src-tauri/capabilities/**)",
      "Edit(/src-tauri/tauri.conf.json)"
    ],
    "deny": [
      "Agent(general-purpose)",
      "Agent(Plan)",
      "Read(/node_modules/**)",
      "Read(/dist/**)",
      "Read(/src-tauri/target/**)",
      "Read(/pnpm-lock.yaml)",
      "Read(/src-tauri/Cargo.lock)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rtk git push *)",
      "Bash(rtk run *)",
      "Bash(rtk proxy git push *)"
    ]
  }
}
