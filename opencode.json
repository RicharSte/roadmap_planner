{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "task": {
      "*": "deny",
      "scout": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "rm -rf*": "ask",
      "git commit*": "ask",
      "pnpm add*": "ask",
      "cargo add*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git checkout -- *": "ask",
      "rtk git push*": "deny",
      "rtk run *": "ask",
      "rtk proxy *": "ask",
      "repowise distill*": "deny",
      "repowise delete*": "ask",
      "repowise hook*": "ask",
      "codegraph uninit*": "ask",
      "codegraph index*": "ask"
    },
    "read": {
      "*": "allow",
      "node_modules/**": "deny",
      "dist/**": "deny",
      "src-tauri/target/**": "deny",
      "pnpm-lock.yaml": "deny",
      "src-tauri/Cargo.lock": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "scout": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "scout": "allow"
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "repowise": {
      "type": "local",
      "command": ["repowise", "mcp", "/Users/ns/prodjects/roadmap_proj", "--transport", "stdio"],
      "enabled": false
    }
  }
}
